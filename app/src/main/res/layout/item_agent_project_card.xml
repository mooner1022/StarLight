<?xml version="1.0" encoding="utf-8"?>
<!-- A shortcut to a project the agent worked on. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="14dp"
    android:paddingVertical="5dp">

    <LinearLayout
        android:id="@+id/card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_agent_card"
        android:orientation="vertical"
        android:paddingBottom="12dp">

        <LinearLayout
            android:id="@+id/main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingTop="12dp"
            android:paddingBottom="8dp">

            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_agent_tile">

                <ImageView
                    android:id="@+id/icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    tools:src="@drawable/ic_round_projects_24"/>
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/wantedsans_bold"
                    android:maxLines="1"
                    android:textColor="@color/agent_text"
                    android:textSize="14.5sp"
                    tools:text="hello-bot"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/status"
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_project_status"/>

                    <TextView
                        android:id="@+id/meta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/wantedsans_regular"
                        android:maxLines="1"
                        android:textColor="@color/agent_text_faint"
                        android:textSize="12sp"
                        tools:text="NeonJS · 실행 중"/>
                </LinearLayout>
            </LinearLayout>

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_round_keyboard_arrow_right_24"
                app:tint="@color/agent_text_faint"/>
        </LinearLayout>

        <TextView
            android:id="@+id/caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:fontFamily="@font/wantedsans_regular"
            android:lineSpacingExtra="2dp"
            android:paddingHorizontal="14dp"
            android:textColor="@color/agent_text_muted"
            android:textSize="13sp"
            android:visibility="gone"
            tools:text="/날씨 명령에 답하는 봇이에요."
            tools:visibility="visible"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <TextView
                android:id="@+id/edit"
                style="@style/AgentCardAction"
                android:text="@string/agent_card_edit"
                app:drawableStartCompat="@drawable/ic_round_edit_24"/>

            <TextView
                android:id="@+id/debug"
                style="@style/AgentCardAction"
                android:text="@string/agent_card_debug"
                app:drawableStartCompat="@drawable/ic_round_insert_comment_24"/>

            <TextView
                android:id="@+id/settings"
                style="@style/AgentCardAction"
                android:text="@string/agent_card_settings"
                app:drawableStartCompat="@drawable/ic_round_settings_24"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
