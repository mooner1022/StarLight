<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.editor.drawer.FileTreeFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/textFilesSummary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/nanumsquare_neo_regular"
            android:maxLines="1"
            android:textColor="@color/text_sub"
            android:textSize="13sp"/>

        <ImageButton
            android:id="@+id/buttonNewFile"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/editor_new_file_short"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_round_note_add_24"
            app:tint="@color/text_sub"/>

        <ImageButton
            android:id="@+id/buttonNewFolder"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/editor_new_folder"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_round_create_new_folder_24"
            app:tint="@color/text_sub"/>

        <ImageButton
            android:id="@+id/buttonCollapseAll"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/editor_collapse_all"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_round_unfold_less_24"
            app:tint="@color/text_sub"/>

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvFileTree"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingBottom="16dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>

</LinearLayout>
