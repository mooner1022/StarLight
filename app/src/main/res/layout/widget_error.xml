<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:minHeight="@dimen/widget_cell_height"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/card_radius">

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_round_error_outline_24"
        app:tint="@color/text_sub"/>

    <TextView
        android:id="@+id/textViewWidgetError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:ellipsize="end"
        android:fontFamily="@font/nanumsquare_round_bold"
        android:maxLines="2"
        android:text="@string/widget_load_failed"
        android:textColor="@color/text_sub"
        android:textSize="13sp"/>

</LinearLayout>
