<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".ui.home.HomeFragment"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/transparent"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingTop="@dimen/fragment_top_padding"
    android:paddingBottom="@dimen/bottom_bar_total_height">

    <androidx.cardview.widget.CardView
        android:id="@+id/editBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/card_margin_horizontal"
        android:layout_marginBottom="12dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/main_dark"
        app:cardCornerRadius="@dimen/card_radius"
        app:cardElevation="@dimen/card_elevation"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="@dimen/button_height"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="4dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/nanumsquare_round_bold"
                    android:text="@string/home_edit_title"
                    android:textColor="@color/white"
                    android:textSize="15sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:alpha="0.8"
                    android:fontFamily="@font/nanumsquare_round_regular"
                    android:text="@string/home_edit_hint"
                    android:textColor="@color/white"
                    android:textSize="12sp"/>
            </LinearLayout>

            <ImageButton
                android:id="@+id/buttonEditAdd"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/home_edit_add"
                android:src="@drawable/ic_round_add_24"
                app:tint="@color/white"/>

            <ImageButton
                android:id="@+id/buttonEditSettings"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/home_edit_settings"
                android:src="@drawable/ic_round_settings_24"
                android:visibility="gone"
                app:tint="@color/white"
                tools:visibility="visible"/>

            <ImageButton
                android:id="@+id/buttonEditRemove"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/home_edit_remove"
                android:src="@drawable/ic_round_delete_forever_24"
                android:visibility="gone"
                app:tint="@color/white"
                tools:visibility="visible"/>

            <TextView
                android:id="@+id/buttonEditDone"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackground"
                android:fontFamily="@font/nanumsquare_round_bold"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="@string/home_edit_done"
                android:textColor="@color/white"
                android:textSize="15sp"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollWidgets"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/widgetContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <dev.mooner.starlight.ui.home.WidgetGridLayout
                android:id="@+id/widgetGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/card_margin_horizontal"/>

            <LinearLayout
                android:id="@+id/emptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="32dp"
                android:paddingVertical="48dp"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/nanumsquare_round_bold"
                    android:text="@string/home_empty_title"
                    android:textColor="@color/text"
                    android:textSize="17sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/nanumsquare_round_regular"
                    android:gravity="center"
                    android:text="@string/home_empty_description"
                    android:textColor="@color/text_sub"
                    android:textSize="13sp"/>

                <TextView
                    android:id="@+id/buttonEmptyAdd"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_home_add_widget"
                    android:drawablePadding="6dp"
                    android:fontFamily="@font/nanumsquare_round_bold"
                    android:gravity="center"
                    android:paddingHorizontal="24dp"
                    android:text="@string/home_add_widget"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    app:drawableStartCompat="@drawable/ic_round_add_24"
                    app:drawableTint="@color/white"/>
            </LinearLayout>

            <TextView
                android:id="@+id/textEditHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:background="?attr/selectableItemBackground"
                android:drawablePadding="4dp"
                android:fontFamily="@font/nanumsquare_round_regular"
                android:gravity="center_vertical"
                android:padding="8dp"
                android:text="@string/home_edit_entry"
                android:textColor="@color/text_sub"
                android:textSize="12sp"
                app:drawableStartCompat="@drawable/ic_round_edit_24"
                app:drawableTint="@color/text_sub"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
