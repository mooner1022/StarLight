<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/transparent"
    android:orientation="vertical"
    android:clipToPadding="false"
    android:paddingTop="@dimen/fragment_top_padding"
    tools:background="@color/background"
    tools:context=".ui.plugins.PluginsFragment">

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/card_margin_horizontal">

        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_weight="1">

            <com.google.android.material.chip.ChipGroup
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleLine="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/align_plugin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxHeight="48dp"
                    android:minWidth="92dp"
                    android:text="@string/aligned_by"
                    tools:text="정렬: 가나다 순"
                    app:chipStartPadding="11dp"
                    app:chipEndPadding="8dp"
                    app:chipIconTint="#80BCBD"
                    app:chipIcon="@drawable/ic_round_sort_by_alpha_24"
                    app:chipMinHeight="48dp"
                    app:chipCornerRadius="18dp"
                    app:chipBackgroundColor="@color/background_chip"/>

            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <ImageButton
            android:id="@+id/plugin_store"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_project_header_button"
            android:contentDescription="@string/plugin_store"
            android:src="@drawable/ic_round_cloud_download_24"
            app:tint="#E9B824"/>

        <ImageButton
            android:id="@+id/search_plugin"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_project_header_button"
            android:contentDescription="@string/plugin_search_hint"
            android:src="@drawable/ic_round_search_24"
            app:tint="#80BCBD"/>

        <com.google.android.material.chip.Chip
            android:id="@+id/install_plugin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxHeight="48dp"
            android:minWidth="64dp"
            android:text="@string/plugin_install"
            android:textColor="@color/text_clear"
            app:chipBackgroundColor="@color/background_chip_accent"
            app:chipCornerRadius="18dp"
            app:chipEndPadding="8dp"
            app:chipIcon="@drawable/ic_round_add_24"
            app:chipIconTint="@color/text_clear"
            app:chipMinHeight="48dp"
            app:chipStartPadding="11dp"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/searchBar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginHorizontal="@dimen/card_margin_horizontal"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_project_search"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_round_search_24"
            app:tint="@color/text_sub"/>

        <EditText
            android:id="@+id/searchInput"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@null"
            android:fontFamily="@font/nanumsquare_neo_regular"
            android:hint="@string/plugin_search_hint"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/text"
            android:textColorHint="@color/text_sub"
            android:textSize="15sp"/>

        <ImageButton
            android:id="@+id/searchClose"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cancel"
            android:src="@drawable/ic_round_close_24"
            app:tint="@color/text_sub"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/notice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/card_margin_horizontal"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_project_search"
        android:gravity="center_vertical"
        android:minHeight="52dp"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="6dp"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:id="@+id/noticeIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_round_refresh_24"
            app:tint="@color/main_bright"/>

        <TextView
            android:id="@+id/noticeText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:layout_weight="1"
            android:fontFamily="@font/nanumsquare_neo_regular"
            android:paddingVertical="10dp"
            android:textColor="@color/text"
            android:textSize="13sp"
            tools:text="@string/plugin_notice_restart"/>

        <Button
            android:id="@+id/noticeAction"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:fontFamily="@font/nanumsquare_neo_bold"
            android:minWidth="0dp"
            android:paddingHorizontal="12dp"
            android:textColor="@color/main_bright"
            android:textSize="13sp"
            tools:text="@string/plugin_restart"/>
    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/card_margin_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="@dimen/card_margin_horizontal"
        android:layout_marginBottom="@dimen/bottom_bar_total_height"
        app:cardCornerRadius="@dimen/card_radius"
        app:cardElevation="@dimen/card_elevation"
        app:cardBackgroundColor="@color/cardview">

        <TextView
            android:id="@+id/textViewNoPluginYet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:drawablePadding="12dp"
            android:fontFamily="@font/nanumsquare_round_bold"
            android:paddingVertical="40dp"
            android:paddingHorizontal="16dp"
            android:text="@string/no_plugins"
            android:textAlignment="center"
            android:textSize="16sp"
            android:visibility="gone"
            app:drawableTint="@color/main_bright"
            app:drawableTopCompat="@drawable/ic_box_empty"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewPluginList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingVertical="6dp"/>
    </androidx.cardview.widget.CardView>
</LinearLayout>
