<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_store_sheet"
    android:orientation="vertical"
    android:paddingTop="12dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_store_sheet_handle"/>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingBottom="4dp">

            <LinearLayout
                android:id="@+id/header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/iconFrame"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_store_icon">

                    <ImageView
                        android:id="@+id/icon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_store_sparkle"
                        app:tint="@color/store_gold"/>
                </FrameLayout>

                <TextView
                    android:id="@+id/title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/nanumsquare_round_extrabold"
                    android:textColor="@color/text"
                    android:textSize="19sp"
                    tools:text="필요한 플러그인 설치"/>
            </LinearLayout>

            <TextView
                android:id="@+id/message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/nanumsquare_neo_regular"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/text_sub"
                android:textSize="14sp"
                tools:text="통계 대시보드을(를) 사용하려면 다음 플러그인이 필요해요."/>

            <LinearLayout
                android:id="@+id/content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"/>

            <TextView
                android:id="@+id/note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:drawablePadding="8dp"
                android:fontFamily="@font/nanumsquare_neo_regular"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/text_sub"
                android:textSize="12sp"
                app:drawableStartCompat="@drawable/ic_store_sparkle_small"
                tools:text="샘플 데이터로 만든 목업이에요."/>

            <LinearLayout
                android:id="@+id/checkboxes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="gone"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/fixedContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:visibility="gone"/>

    <View
        android:id="@+id/buttonsDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:alpha="0"
        android:background="@color/store_chip_stroke"/>

    <LinearLayout
        android:id="@+id/buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical|end"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingTop="14dp"
        android:paddingBottom="20dp">

        <TextView
            android:id="@+id/neutral"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@drawable/bg_store_text_button"
            android:fontFamily="@font/nanumsquare_neo_extrabold"
            android:gravity="center"
            android:paddingHorizontal="18dp"
            android:textColor="@color/text_sub"
            android:textSize="14sp"
            tools:text="저장 안 함"/>

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <TextView
            android:id="@+id/negative"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@drawable/bg_store_text_button"
            android:fontFamily="@font/nanumsquare_neo_extrabold"
            android:gravity="center"
            android:paddingHorizontal="18dp"
            android:textColor="@color/store_gold_deep"
            android:textSize="14sp"
            tools:text="취소"/>

        <TextView
            android:id="@+id/positive"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_store_gold_pill"
            android:fontFamily="@font/nanumsquare_neo_extrabold"
            android:gravity="center"
            android:minWidth="112dp"
            android:paddingHorizontal="22dp"
            android:textColor="@color/store_on_gold"
            android:textSize="14sp"
            tools:text="모두 설치"/>
    </LinearLayout>
</LinearLayout>
