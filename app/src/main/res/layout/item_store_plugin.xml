<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="6dp"
    android:paddingVertical="5dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_store_card"
        android:foreground="?attr/selectableItemBackground"
        android:padding="14dp">

        <FrameLayout
            android:id="@+id/iconFrame"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_store_icon"
            android:foreground="@drawable/fg_store_icon_border"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                tools:src="@drawable/ic_store_icon_placeholder"/>
        </FrameLayout>

        <TextView
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:ellipsize="end"
            android:fontFamily="@font/nanumsquare_neo_extrabold"
            android:maxLines="1"
            android:textColor="@color/text"
            android:textSize="15sp"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toTopOf="@+id/summary"
            app:layout_constraintEnd_toStartOf="@+id/verified"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toEndOf="@+id/iconFrame"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            tools:text="Discord 브릿지"/>

        <ImageView
            android:id="@+id/verified"
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="10dp"
            android:contentDescription="@string/plugin_store_verified"
            android:src="@drawable/ic_store_sparkle"
            app:layout_constraintBottom_toBottomOf="@+id/name"
            app:layout_constraintEnd_toStartOf="@+id/install"
            app:layout_constraintStart_toEndOf="@+id/name"
            app:layout_constraintTop_toTopOf="@+id/name"/>

        <TextView
            android:id="@+id/summary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="10dp"
            android:ellipsize="end"
            android:fontFamily="@font/nanumsquare_neo_regular"
            android:lineSpacingExtra="2dp"
            android:maxLines="2"
            android:textColor="@color/text_sub"
            android:textSize="12sp"
            app:layout_constraintBottom_toTopOf="@+id/meta"
            app:layout_constraintEnd_toStartOf="@+id/install"
            app:layout_constraintStart_toStartOf="@+id/name"
            app:layout_constraintTop_toBottomOf="@+id/name"
            tools:text="카카오톡 방과 디스코드 채널을 서로 연결해요"/>

        <TextView
            android:id="@+id/meta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="10dp"
            android:ellipsize="end"
            android:fontFamily="@font/nanumsquare_neo_bold"
            android:maxLines="1"
            android:textColor="@color/store_gold_deep"
            android:textSize="11sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/install"
            app:layout_constraintStart_toStartOf="@+id/name"
            app:layout_constraintTop_toBottomOf="@+id/summary"
            tools:text="mooner1022 · v1.2.0 · 3.8 MB"/>

        <dev.mooner.starlight.ui.plugins.store.StoreInstallButton
            android:id="@+id/install"
            android:layout_width="76dp"
            android:layout_height="34dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
