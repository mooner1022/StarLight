<?xml version="1.0" encoding="utf-8"?>
<!-- Heads a run's tool calls; collapsed, only the latest call shows under it. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp"
    android:paddingVertical="2dp">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp">

        <ImageView
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_agent_tools"
            app:tint="@color/agent_text_faint"/>

        <TextView
            android:id="@+id/label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="@font/wantedsans_medium"
            android:textColor="@color/agent_text_faint"
            android:textSize="13sp"
            tools:text="도구 6개 사용"/>

        <ImageView
            android:id="@+id/chevron"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_round_keyboard_arrow_down_24"
            app:tint="@color/agent_text_faint"/>
    </LinearLayout>
</LinearLayout>
