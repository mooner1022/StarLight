<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/contentRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="8dp"
    android:theme="@style/Theme.StarLight">

    <LinearLayout
        android:id="@+id/stepBar"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginHorizontal="4dp"
        android:orientation="horizontal"/>

    <TextView
        android:id="@+id/stepCounter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="14dp"
        android:fontFamily="@font/nanumsquare_neo_bold"
        android:textColor="@color/main_bright"
        android:textSize="12sp"
        tools:text="1 / 4"/>

    <TextView
        android:id="@+id/stepTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="4dp"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/nanumsquare_neo_bold"
        android:textColor="@color/text"
        android:textSize="18sp"
        tools:text="@string/new_project_step_name"/>

    <TextView
        android:id="@+id/stepDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="4dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="14dp"
        android:fontFamily="@font/nanumsquare_neo_regular"
        android:textColor="@color/text_sub"
        android:textSize="13sp"
        tools:text="@string/project_name_hint"/>

    <LinearLayout
        android:id="@+id/pageName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <EditText
            android:id="@+id/newProjectInput"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/configdsl_field_background"
            android:fontFamily="@font/nanumsquare_neo_regular"
            android:hint="@string/project_name_example"
            android:imeOptions="actionNext"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLength="40"
            android:maxLines="1"
            android:paddingHorizontal="14dp"
            android:textColor="@color/text"
            android:textColorHint="@color/text_sub"
            android:textSize="16sp"/>

        <TextView
            android:id="@+id/nameHelper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="4dp"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/nanumsquare_neo_regular"
            android:textColor="@color/text_sub"
            android:textSize="12sp"
            tools:text="@string/project_main_file"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/pageLanguage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"/>

    <LinearLayout
        android:id="@+id/pageEvents"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/configdsl_field_background"
        android:orientation="vertical"
        android:paddingVertical="4dp"
        android:visibility="gone"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/pageConfig"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:nestedScrollingEnabled="false"
        android:overScrollMode="never"
        android:visibility="gone"/>
</LinearLayout>
