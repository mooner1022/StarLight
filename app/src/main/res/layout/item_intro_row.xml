<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:background="@drawable/bg_intro_card"
    android:gravity="center_vertical"
    android:minHeight="76dp"
    android:orientation="horizontal"
    android:padding="16dp">

    <FrameLayout
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_intro_icon">

        <ImageView
            android:id="@+id/icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            app:tint="@color/store_gold"
            tools:src="@drawable/ic_round_sd_storage_24"/>

    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/nanumsquare_neo_bold"
            android:textColor="@color/store_star"
            android:textSize="16sp"
            tools:text="@string/intro_perm_storage"/>

        <TextView
            android:id="@+id/description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/nanumsquare_neo_regular"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/intro_text_sub"
            android:textSize="13sp"
            tools:text="@string/intro_perm_storage_desc"/>

    </LinearLayout>

    <FrameLayout
        android:id="@+id/trailing"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/allow"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_intro_allow"
            android:fontFamily="@font/nanumsquare_neo_bold"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:text="@string/intro_allow"
            android:textColor="@color/store_gold"
            android:textSize="13sp"/>

        <ImageView
            android:id="@+id/granted"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_intro_granted"
            android:importantForAccessibility="no"
            android:padding="6dp"
            android:src="@drawable/ic_round_check_24"
            android:visibility="invisible"
            app:tint="@color/store_on_gold"/>

    </FrameLayout>

</LinearLayout>
