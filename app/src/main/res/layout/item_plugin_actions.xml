<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/actionRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingHorizontal="8dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/buttonPluginConfig"
        style="@style/ProjectAction"
        android:text="@string/project_settings"
        app:drawableTopCompat="@drawable/ic_round_settings_24"/>

    <TextView
        android:id="@+id/buttonPluginInfo"
        style="@style/ProjectAction"
        android:text="@string/project_info"
        app:drawableTopCompat="@drawable/ic_round_info_24"/>

    <TextView
        android:id="@+id/buttonPluginRemove"
        style="@style/ProjectAction"
        android:text="@string/plugin_remove"
        app:drawableTopCompat="@drawable/ic_round_delete_24"/>
</LinearLayout>
