<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="14dp"
    android:paddingVertical="3dp">

    <LinearLayout
        android:id="@+id/card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_agent_tool"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:minHeight="44dp"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <FrameLayout
                android:layout_width="26dp"
                android:layout_height="26dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_agent_chip"
                    android:backgroundTint="@color/agent_meteor_soft"/>

                <ImageView
                    android:id="@+id/icon"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    app:tint="@color/agent_meteor"
                    tools:src="@drawable/ic_round_edit_24"/>
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingVertical="6dp">

                <TextView
                    android:id="@+id/label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/wantedsans_medium"
                    android:textColor="@color/agent_text"
                    android:textSize="13.5sp"
                    tools:text="파일 수정"/>

                <TextView
                    android:id="@+id/detail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/jbmono_nl_regular"
                    android:maxLines="1"
                    android:textColor="@color/agent_text_faint"
                    android:textSize="11.5sp"
                    tools:text="hello-bot.js"/>
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progress"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:indeterminateTint="@color/agent_meteor"
                android:visibility="gone"/>

            <ImageView
                android:id="@+id/status"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_agent_check"
                app:tint="@color/agent_ok"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingBottom="10dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/diffLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:fontFamily="@font/wantedsans_bold"
                android:text="@string/agent_tool_diff"
                android:textColor="@color/agent_text_faint"
                android:textSize="11sp"
                android:visibility="gone"/>

            <HorizontalScrollView
                android:id="@+id/diffScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_agent_code"
                android:scrollbars="none"
                android:visibility="gone">

                <TextView
                    android:id="@+id/diff"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/jbmono_nl_regular"
                    android:padding="10dp"
                    android:textColor="@color/agent_text_muted"
                    android:textIsSelectable="true"
                    android:textSize="11.5sp"/>
            </HorizontalScrollView>

            <TextView
                android:id="@+id/argumentsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/wantedsans_bold"
                android:text="@string/agent_tool_arguments"
                android:textColor="@color/agent_text_faint"
                android:textSize="11sp"/>

            <TextView
                android:id="@+id/arguments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_agent_code"
                android:fontFamily="@font/jbmono_nl_regular"
                android:padding="10dp"
                android:textColor="@color/agent_text_muted"
                android:textIsSelectable="true"
                android:textSize="11.5sp"/>

            <TextView
                android:id="@+id/outputLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/wantedsans_bold"
                android:text="@string/agent_tool_output"
                android:textColor="@color/agent_text_faint"
                android:textSize="11sp"/>

            <TextView
                android:id="@+id/output"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_agent_code"
                android:fontFamily="@font/jbmono_nl_regular"
                android:padding="10dp"
                android:textColor="@color/agent_text_muted"
                android:textIsSelectable="true"
                android:textSize="11.5sp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
