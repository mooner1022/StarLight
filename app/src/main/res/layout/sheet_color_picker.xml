<?xml version="1.0" encoding="utf-8"?>
<!-- The color picker sheet's content: the picked color, the palette, its shades and a color typed in. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/background_selection_card"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <View
                android:id="@+id/preview"
                android:layout_width="36dp"
                android:layout_height="36dp"/>

            <TextView
                android:id="@+id/previewText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:fontFamily="@font/wantedsans_medium"
                android:includeFontPadding="false"
                android:textColor="@color/text"
                android:textSize="15sp"
                tools:text="#DFC199"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Shown when a color can be typed in: the palette, or the wheel and the code. -->
    <LinearLayout
        android:id="@+id/modes"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_segment_track"
        android:orientation="horizontal"
        android:padding="4dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/modePalette"
            style="@style/ColorPickerMode"
            android:text="@string/color_picker_palette"/>

        <TextView
            android:id="@+id/modeCustom"
            style="@style/ColorPickerMode"
            android:text="@string/color_picker_custom"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/palettePage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.flexbox.FlexboxLayout
            android:id="@+id/swatches"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:flexWrap="wrap"
            app:justifyContent="flex_start"/>

        <TextView
            android:id="@+id/shadesLabel"
            style="@style/ColorPickerLabel"
            android:text="@string/color_picker_shades"
            android:visibility="gone"/>

        <com.google.android.flexbox.FlexboxLayout
            android:id="@+id/shades"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:flexWrap="wrap"
            app:justifyContent="flex_start"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/custom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <!-- Hue around, saturation outward; brightness and opacity below. -->
        <dev.mooner.starlight.ui.common.HsvColorWheel
            android:id="@+id/wheel"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:id="@+id/brightnessRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="84dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/wantedsans_regular"
                android:text="@string/color_picker_brightness"
                android:textColor="@color/text"
                android:textSize="14sp"/>

            <com.google.android.material.slider.Slider
                android:id="@+id/brightness"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:stepSize="1"
                android:valueFrom="0"
                android:valueTo="100"
                app:labelBehavior="gone"
                app:tickVisible="false"
                app:thumbColor="@color/main_bright"
                app:trackColorActive="@color/main_bright"
                app:trackColorInactive="@color/cardview_gray"/>

            <TextView
                android:id="@+id/brightnessValue"
                android:layout_width="44dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/wantedsans_regular"
                android:gravity="end"
                android:textColor="@color/text_sub"
                android:textSize="13sp"
                tools:text="100%"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/opacityRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:layout_width="84dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/wantedsans_regular"
                android:text="@string/color_picker_opacity"
                android:textColor="@color/text"
                android:textSize="14sp"/>

            <com.google.android.material.slider.Slider
                android:id="@+id/opacity"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:stepSize="1"
                android:valueFrom="0"
                android:valueTo="100"
                app:labelBehavior="gone"
                app:tickVisible="false"
                app:thumbColor="@color/main_bright"
                app:trackColorActive="@color/main_bright"
                app:trackColorInactive="@color/cardview_gray"/>

            <TextView
                android:id="@+id/opacityValue"
                android:layout_width="44dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/wantedsans_regular"
                android:gravity="end"
                android:textColor="@color/text_sub"
                android:textSize="13sp"
                tools:text="100%"/>
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/hexLayout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:boxCornerRadiusBottomEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusTopStart="14dp"
            app:boxStrokeColor="@color/store_gold_deep"
            app:errorEnabled="false"
            app:hintEnabled="false"
            app:prefixText="#"
            app:prefixTextColor="@color/text_sub">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/hexInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:digits="0123456789abcdefABCDEF"
                android:fontFamily="@font/jbmono_nl_regular"
                android:hint="@string/color_picker_hex_hint"
                android:imeOptions="actionDone"
                android:inputType="textNoSuggestions|textCapCharacters"
                android:maxLength="8"
                android:textColor="@color/text"
                android:textSize="15sp"/>
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>
</LinearLayout>
