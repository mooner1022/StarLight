<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    android:layout_weight="1"
    android:background="@drawable/bg_sheet_grid_item"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="6dp"
    android:paddingVertical="14dp">

    <FrameLayout
        android:id="@+id/iconFrame"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_store_icon"
        android:duplicateParentState="true">

        <ImageView
            android:id="@+id/icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            app:tint="@color/store_gold_deep"
            tools:src="@drawable/ic_round_sort_by_alpha_24"/>
    </FrameLayout>

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/nanumsquare_neo_bold"
        android:gravity="center"
        android:maxLines="2"
        android:textColor="@color/text"
        android:textSize="13sp"
        tools:text="가나다 순"/>
</LinearLayout>
