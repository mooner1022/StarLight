<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".ui.plugins.config.PluginConfigActivity">

    <!-- The main screen\'s sky, behind the content. -->
    <include
        android:id="@+id/skyHeader"
        layout="@layout/view_sky_header"/>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <TextView
                        style="@style/PageTitle"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginStart="@dimen/title_margin_start"
                    android:layout_marginEnd="@dimen/page_title_margin_end"
                        android:layout_marginTop="76dp"
                        android:text="@string/title_settings"/>

                <TextView
                        android:id="@+id/pluginName"
                        style="@style/PageSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/title_margin_start"
                        android:layout_marginBottom="30dp"
                        android:elevation="1dp"
                        android:text="PLUGIN_NAME"
                        app:layout_collapseMode="parallax"/>

            </LinearLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/configRecyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginTop="25dp"
                        android:overScrollMode="never"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        android:layout_marginStart="@dimen/card_margin_horizontal"
                        android:layout_marginEnd="@dimen/card_margin_horizontal"
                        android:layout_marginBottom="@dimen/card_margin_horizontal"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>


    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabPluginConfig"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/fab_margin"
        android:layout_marginBottom="@dimen/fab_margin"
        android:clickable="true"
        android:visibility="invisible"
        android:focusable="true"
        app:tint="#FFFFFF"
        app:srcCompat="@drawable/ic_round_save_white_24" />

    <ImageButton
        android:id="@+id/leave"
        style="@style/PageBackButton"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>