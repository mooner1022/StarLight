<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/nanumsquare_neo_extrabold"
            android:textColor="@color/text"
            android:textSize="15sp"
            tools:text="v1.2.0"/>

        <TextView
            android:id="@+id/latest"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_store_gold_pill"
            android:fontFamily="@font/nanumsquare_neo_extrabold"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="@string/plugin_store_latest"
            android:textColor="@color/store_on_gold"
            android:textSize="10sp"/>

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <TextView
            android:id="@+id/date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/nanumsquare_neo_regular"
            android:textColor="@color/text_sub"
            android:textSize="12sp"
            tools:text="2일 전"/>
    </LinearLayout>

    <TextView
        android:id="@+id/changelog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/nanumsquare_neo_regular"
        android:lineSpacingExtra="3dp"
        android:textColor="@color/text"
        android:textSize="13sp"
        tools:text="- 스레드 메시지 전달 지원"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/meta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/nanumsquare_neo_bold"
            android:textColor="@color/store_gold_deep"
            android:textSize="11sp"
            tools:text="API 0.3 · 3.8 MB"/>

        <TextView
            android:id="@+id/installVersion"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackground"
            android:fontFamily="@font/nanumsquare_neo_extrabold"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            android:text="@string/plugin_store_install_version"
            android:textColor="@color/store_gold_deep"
            android:textSize="12sp"/>
    </LinearLayout>
</LinearLayout>
