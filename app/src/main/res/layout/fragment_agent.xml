<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/transparent"
    android:clipToPadding="false"
    android:fillViewport="true"
    tools:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/card_margin_horizontal"
        android:paddingTop="@dimen/fragment_top_padding"
        android:paddingBottom="24dp">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/agent_night_mid"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp">

            <!-- The stars fill whatever height the content gives, so they don't size the card themselves. -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_agent_night">

                <dev.mooner.starlight.ui.plugins.store.StarFieldView
                    android:id="@+id/stars"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>

                <ImageView
                    android:layout_width="104dp"
                    android:layout_height="104dp"
                    android:layout_marginTop="-22dp"
                    android:layout_marginEnd="-26dp"
                    android:alpha="0.35"
                    android:importantForAccessibility="no"
                    android:rotation="12"
                    android:src="@drawable/ic_logo_transparent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_agent_sparkle"
                        app:tint="@color/agent_gold"/>

                    <TextView
                        android:id="@+id/heroTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="@font/wantedsans_bold"
                        android:text="@string/agent_hero_title"
                        android:textColor="@color/agent_on_night"
                        android:textSize="22sp"/>

                    <TextView
                        android:id="@+id/heroBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/wantedsans_regular"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/agent_hero_body"
                        android:textColor="@color/agent_on_night_muted"
                        android:textSize="13.5sp"/>

                    <TextView
                        android:id="@+id/model"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_agent_night_chip"
                        android:drawablePadding="4dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/wantedsans_medium"
                        android:gravity="center_vertical"
                        android:maxLines="1"
                        android:paddingStart="12dp"
                        android:paddingEnd="8dp"
                        android:textColor="@color/agent_on_night"
                        android:textSize="12.5sp"
                        app:drawableEndCompat="@drawable/ic_round_keyboard_arrow_down_24"
                        app:drawableTint="@color/agent_on_night_muted"
                        tools:text="Claude Opus 5.5 · Anthropic"/>

                    <include
                        android:id="@+id/composer"
                        layout="@layout/view_agent_composer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"/>

                    <TextView
                        android:id="@+id/connect"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_agent_button_gold"
                        android:fontFamily="@font/wantedsans_bold"
                        android:gravity="center"
                        android:text="@string/agent_setup_action"
                        android:textColor="@color/agent_on_gold"
                        android:textSize="15sp"
                        android:visibility="gone"/>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>

        <HorizontalScrollView
            android:id="@+id/suggestionsScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clipToPadding="false"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/suggestions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"/>
        </HorizontalScrollView>

        <TextView
            android:id="@+id/runningTitle"
            style="@style/AgentSectionTitle"
            android:layout_marginStart="4dp"
            android:layout_marginTop="22dp"
            android:text="@string/agent_section_running"
            android:textColor="@color/text"/>

        <LinearLayout
            android:id="@+id/running"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/AgentSectionTitle"
                android:layout_width="0dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="@string/agent_section_recent"
                android:textColor="@color/text"/>

            <ImageButton
                android:id="@+id/newChat"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/agent_new_chat"
                android:src="@drawable/ic_round_add_24"
                app:tint="@color/text_sub"/>

            <ImageButton
                android:id="@+id/settings"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/agent_settings"
                android:src="@drawable/ic_round_settings_24"
                app:tint="@color/text_sub"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/conversations"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"/>

        <TextView
            android:id="@+id/empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_agent_surface"
            android:fontFamily="@font/wantedsans_regular"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:paddingVertical="28dp"
            android:text="@string/agent_no_conversations"
            android:textColor="@color/agent_text_muted"
            android:textSize="14sp"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
