<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/composerRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_agent_composer"
    android:orientation="vertical"
    android:paddingVertical="6dp">

    <HorizontalScrollView
        android:id="@+id/attachmentsScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingHorizontal="10dp"
        android:paddingTop="4dp"
        android:scrollbars="none"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:id="@+id/attachments"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"/>
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp">

        <ImageButton
            android:id="@+id/attach"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/agent_attach"
            android:src="@drawable/ic_agent_attach"
            app:tint="@color/agent_text_muted"/>

        <EditText
            android:id="@+id/input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@null"
            android:fontFamily="@font/wantedsans_regular"
            android:hint="@string/agent_composer_hint"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="6"
            android:minHeight="44dp"
            android:paddingHorizontal="4dp"
            android:paddingVertical="10dp"
            android:textColor="@color/agent_text"
            android:textColorHint="@color/agent_text_faint"
            android:textSize="15sp"/>

        <ImageButton
            android:id="@+id/send"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="2dp"
            android:background="@drawable/bg_agent_send"
            android:contentDescription="@string/agent_send"
            android:src="@drawable/ic_agent_send"
            app:tint="@color/agent_on_gold"/>
    </LinearLayout>
</LinearLayout>
