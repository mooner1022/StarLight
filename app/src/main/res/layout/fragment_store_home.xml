<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="110dp">

            <FrameLayout
                android:id="@+id/hero"
                android:layout_width="match_parent"
                android:layout_height="268dp"
                android:background="@drawable/bg_store_hero">

                <dev.mooner.starlight.ui.plugins.store.StarFieldView
                    android:id="@+id/stars"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>

                <ImageView
                    android:id="@+id/heroLogo"
                    android:layout_width="170dp"
                    android:layout_height="170dp"
                    android:layout_gravity="end|bottom"
                    android:layout_marginEnd="-36dp"
                    android:layout_marginBottom="-30dp"
                    android:alpha="0.85"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_logo_transparent"/>

                <LinearLayout
                    android:id="@+id/heroText"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="bottom"
                    android:orientation="vertical"
                    android:paddingStart="24dp"
                    android:paddingEnd="120dp"
                    android:paddingBottom="50dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/nanumsquare_neo_extrabold"
                        android:letterSpacing="0.3"
                        android:text="STARLIGHT"
                        android:textColor="@color/store_gold"
                        android:textSize="11sp"
                        tools:ignore="HardcodedText"/>

                    <TextView
                        android:id="@+id/title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/nanumsquare_round_extrabold"
                        android:text="@string/plugin_store_title"
                        android:textColor="@color/store_star"
                        android:textSize="28sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:alpha="0.7"
                        android:fontFamily="@font/nanumsquare_neo_regular"
                        android:text="@string/plugin_store_subtitle"
                        android:textColor="@color/store_star"
                        android:textSize="13sp"/>

                    <LinearLayout
                        android:id="@+id/repository"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_store_repository"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="7dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="6dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_github"
                            app:tint="@color/store_gold"/>

                        <TextView
                            android:id="@+id/repositoryName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="7dp"
                            android:ellipsize="end"
                            android:fontFamily="@font/nanumsquare_neo_bold"
                            android:maxLines="1"
                            android:textColor="@color/store_star"
                            android:textSize="12sp"
                            tools:text="StarLight Plugins"/>

                        <TextView
                            android:id="@+id/repositorySync"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:alpha="0.6"
                            android:fontFamily="@font/nanumsquare_neo_regular"
                            android:maxLines="1"
                            android:textColor="@color/store_star"
                            android:textSize="11sp"
                            tools:text="3분 전 동기화"/>

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginStart="2dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_round_keyboard_arrow_right_24"
                            app:tint="@color/store_star"/>
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <LinearLayout
                android:id="@+id/searchBar"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginHorizontal="18dp"
                android:layout_marginTop="-26dp"
                android:background="@drawable/bg_store_search"
                android:elevation="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_round_search_24"
                    app:tint="@color/store_gold_deep"/>

                <EditText
                    android:id="@+id/searchInput"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:fontFamily="@font/nanumsquare_neo_regular"
                    android:hint="@string/plugin_store_search_hint"
                    android:imeOptions="actionSearch"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="@color/text"
                    android:textColorHint="@color/text_sub"
                    android:textSize="14sp"/>

                <ImageButton
                    android:id="@+id/searchClear"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cancel"
                    android:src="@drawable/ic_round_close_24"
                    android:visibility="invisible"
                    app:tint="@color/text_sub"/>
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:clipToPadding="false"
                android:paddingHorizontal="16dp"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/categories"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:chipSpacingHorizontal="8dp"
                    app:selectionRequired="true"
                    app:singleLine="true"
                    app:singleSelection="true"/>
            </HorizontalScrollView>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <dev.mooner.starlight.ui.plugins.store.StoreShimmerLayout
                    android:id="@+id/skeleton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="16dp">

                        <View
                            style="@style/StoreSkeleton"
                            android:layout_width="120dp"
                            android:layout_height="18dp"
                            android:layout_marginTop="28dp"/>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="196dp"
                            android:layout_marginTop="14dp"
                            android:background="@drawable/bg_store_card"
                            android:backgroundTint="@color/store_skeleton"/>

                        <View
                            style="@style/StoreSkeleton"
                            android:layout_width="140dp"
                            android:layout_height="18dp"
                            android:layout_marginTop="30dp"
                            android:layout_marginBottom="6dp"/>

                        <include layout="@layout/item_store_skeleton"/>
                        <include layout="@layout/item_store_skeleton"/>
                        <include layout="@layout/item_store_skeleton"/>
                        <include layout="@layout/item_store_skeleton"/>
                    </LinearLayout>
                </dev.mooner.starlight.ui.plugins.store.StoreShimmerLayout>

                <LinearLayout
                    android:id="@+id/error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingHorizontal="32dp"
                    android:paddingTop="56dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ImageView
                        android:id="@+id/errorStar"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:alpha="0.5"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_logo_transparent"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:fontFamily="@font/nanumsquare_round_bold"
                        android:text="@string/plugin_store_error"
                        android:textColor="@color/text"
                        android:textSize="16sp"/>

                    <TextView
                        android:id="@+id/errorMessage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/nanumsquare_neo_regular"
                        android:gravity="center"
                        android:textColor="@color/text_sub"
                        android:textSize="12sp"
                        tools:text="Unable to resolve host"/>

                    <TextView
                        android:id="@+id/retry"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/bg_store_gold_pill"
                        android:fontFamily="@font/nanumsquare_neo_extrabold"
                        android:gravity="center"
                        android:paddingHorizontal="24dp"
                        android:text="@string/plugin_store_retry"
                        android:textColor="@color/store_on_gold"
                        android:textSize="14sp"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <LinearLayout
                        android:id="@+id/featuredSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            style="@style/StoreSectionTitle"
                            android:layout_marginStart="20dp"
                            android:text="@string/plugin_store_featured"/>

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/featured"
                            android:layout_width="match_parent"
                            android:layout_height="196dp"
                            android:layout_marginHorizontal="16dp"
                            android:clipChildren="false"
                            android:nestedScrollingEnabled="false"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/updatesCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/bg_store_updates"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_store_icon">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_round_download_24"
                                app:tint="@color/store_gold"/>
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/updatesTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/nanumsquare_neo_extrabold"
                                android:textColor="@color/text"
                                android:textSize="14sp"
                                tools:text="업데이트 2개"/>

                            <TextView
                                android:id="@+id/updatesNames"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:ellipsize="end"
                                android:fontFamily="@font/nanumsquare_neo_regular"
                                android:maxLines="1"
                                android:textColor="@color/text_sub"
                                android:textSize="12sp"
                                tools:text="Discord 브릿지, NetKit"/>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/updateAll"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_store_gold_pill"
                            android:fontFamily="@font/nanumsquare_neo_extrabold"
                            android:gravity="center"
                            android:paddingHorizontal="14dp"
                            android:text="@string/plugin_store_update_all"
                            android:textColor="@color/store_on_gold"
                            android:textSize="12sp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="20dp"
                        android:paddingEnd="12dp">

                        <TextView
                            android:id="@+id/listTitle"
                            style="@style/StoreSectionTitle"
                            android:text="@string/plugin_store_all"/>

                        <TextView
                            android:id="@+id/listCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_marginTop="16dp"
                            android:background="@drawable/bg_store_pill"
                            android:fontFamily="@font/nanumsquare_neo_bold"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="2dp"
                            android:textColor="@color/store_gold_deep"
                            android:textSize="11sp"
                            tools:text="8"/>

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1"/>

                        <TextView
                            android:id="@+id/sort"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:layout_marginTop="16dp"
                            android:background="?attr/selectableItemBackground"
                            android:drawablePadding="4dp"
                            android:fontFamily="@font/nanumsquare_neo_bold"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="8dp"
                            android:textColor="@color/text_sub"
                            android:textSize="12sp"
                            app:drawableEndCompat="@drawable/ic_round_import_export_24"
                            app:drawableTint="@color/text_sub"
                            tools:text="최근 업데이트 순"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/empty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:drawablePadding="12dp"
                        android:fontFamily="@font/nanumsquare_round_bold"
                        android:gravity="center"
                        android:paddingVertical="40dp"
                        android:text="@string/plugin_store_empty"
                        android:textColor="@color/text_sub"
                        android:textSize="14sp"
                        android:visibility="gone"
                        app:drawableTopCompat="@drawable/ic_store_sparkle"/>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipToPadding="false"
                        android:nestedScrollingEnabled="false"
                        android:paddingHorizontal="10dp"/>
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <FrameLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp">

        <View
            android:id="@+id/topBarBackground"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"
            android:background="@color/background"
            android:elevation="2dp"/>

        <ImageButton
            android:id="@+id/back"
            style="@style/StoreTopBarButton"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="4dp"
            android:contentDescription="@string/cancel"
            android:elevation="2dp"
            android:src="@drawable/ic_round_arrow_left_24"
            app:tint="@color/store_star"/>

        <TextView
            android:id="@+id/topTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:alpha="0"
            android:elevation="2dp"
            android:fontFamily="@font/nanumsquare_round_extrabold"
            android:text="@string/plugin_store_title"
            android:textColor="@color/text"
            android:textSize="16sp"/>

        <ImageButton
            android:id="@+id/refresh"
            style="@style/StoreTopBarButton"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="4dp"
            android:contentDescription="@string/plugin_store_reload"
            android:elevation="2dp"
            android:src="@drawable/ic_round_refresh_24"
            app:tint="@color/store_star"/>
    </FrameLayout>
</FrameLayout>
