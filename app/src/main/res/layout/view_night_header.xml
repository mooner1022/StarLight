<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/nightSky"
    android:layout_width="match_parent"
    android:layout_height="230dp"
    android:importantForAccessibility="noHideDescendants"
    android:visibility="gone">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_night_header_glow"/>

    <dev.mooner.starlight.ui.plugins.store.StarFieldView
        android:id="@+id/nightStars"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <dev.mooner.starlight.ui.common.NightEmblemView
        android:id="@+id/nightEmblem"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_night_header_fade"/>

</FrameLayout>
