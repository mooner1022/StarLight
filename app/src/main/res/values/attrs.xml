<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="ExpandableCard">
        <attr name="title" format="string"/>
        <attr name="innerView" format="reference"/>
        <attr name="icon" format="reference"/>
        <attr name="startExpanded" format="boolean"/>
        <attr name="showSwitch" format="boolean"/>
    </declare-styleable>

    <declare-styleable name="SkyEmblemView">
        <attr name="emblemSize" format="dimension"/>
        <attr name="emblemCenterFromEnd" format="dimension"/>
        <attr name="emblemCenterFromTop" format="dimension"/>
        <attr name="emblemBackdrop" format="boolean"/>
        <attr name="emblemWashSpread" format="float"/>
    </declare-styleable>

    <integer name="layoutMode">0</integer>
</resources>