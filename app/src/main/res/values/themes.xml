<resources>
    <!-- Base application theme. -->
    <style name="Theme.StarLight" parent="Theme.MaterialComponents.DayNight">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/main_bright</item>
        <item name="colorPrimaryVariant">@color/sub_bright</item>
        <item name="colorOnPrimary">@color/black</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/main_dark</item>
        <item name="colorSecondaryVariant">@color/main_dark</item>
        <item name="colorOnSecondary">@color/black</item>

        <item name="colorControlActivated">@color/main_dark</item>
        <item name="colorControlNormal">@color/main_bright</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/status_bar</item>
        <item name="android:actionMenuTextColor">@color/black</item>

        <!--dialog background color. -->
        <item name="colorBackgroundFloating">@color/background_dialog</item>

        <item name="android:activityOpenEnterAnimation">
            @anim/activity_fade_in</item>

        <item name="chipMinHeight">40dp</item>
        <item name="chipCornerRadius">15dp</item>
        <item name="chipBackgroundColor">#fcfcff</item>
    </style>

    <style name="Theme.StarLight.Editor" parent="Theme.StarLight">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.StarLight.NoActionBar" parent="Theme.StarLight">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.StarLight.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="Theme.StarLight.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

    <style name="EditorTitleTextAppearance">

        <item name="android:fontFamily">@font/wantedsans_regular</item>
    </style>

    <style name="ExpandedAppBar" parent="@android:style/TextAppearance.Medium">
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/nanumsquare_round_bold</item>
    </style>

    <style name="CollapsedAppBar" parent="@android:style/TextAppearance.Medium">
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/nanumsquare_round_bold</item>
    </style>

    <style name="Stepper.CardView" parent="CardView">
        <item name="cardElevation">0dp</item>
        <item name="cardCornerRadius">@dimen/card_radius</item>
    </style>

    <style name="ProjectAction">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:drawablePadding">2dp</item>
        <item name="drawableTint">@color/text</item>
        <item name="android:ellipsize">end</item>
        <item name="android:fontFamily">@font/nanumsquare_neo_regular</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:paddingVertical">4dp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">11sp</item>
    </style>
</resources>
