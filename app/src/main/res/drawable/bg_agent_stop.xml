<?xml version="1.0" encoding="utf-8"?>
<!-- The stop button beside the send button: a quiet disc, so the gold one stays the one to send with. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#33000000">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/agent_surface_alt"/>
            <stroke android:width="1dp" android:color="@color/agent_stroke"/>
        </shape>
    </item>
</ripple>
