<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:endColor="@color/store_night_light"
                android:startColor="@color/store_night"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.9"
                android:centerY="0.1"
                android:endColor="#00DFC199"
                android:gradientRadius="220dp"
                android:startColor="#59DFC199"
                android:type="radial"/>
        </shape>
    </item>
</layer-list>
