<?xml version="1.0" encoding="utf-8"?>
<!-- By day a featured card is a light card with the sunset in its corner. The night's is in drawable-night/. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/store_hero_surface"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerColor="#3DC073A0"
                android:centerX="0.95"
                android:centerY="0.12"
                android:endColor="#006455A2"
                android:gradientRadius="230dp"
                android:startColor="#80F59193"
                android:type="radial"/>
        </shape>
    </item>
</layer-list>
