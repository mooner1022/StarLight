<?xml version="1.0" encoding="utf-8"?>
<!-- A table cell's right edge; drawn inside the cell so the row keeps the width the table measured. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:gravity="end|fill_vertical" android:width="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/agent_stroke"/>
        </shape>
    </item>
</layer-list>
