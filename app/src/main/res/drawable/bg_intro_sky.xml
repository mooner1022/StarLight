<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="@color/store_night_light"
                android:startColor="@color/store_night"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.5"
                android:centerY="0.32"
                android:endColor="#00DFC199"
                android:gradientRadius="320dp"
                android:startColor="#22DFC199"
                android:type="radial"/>
        </shape>
    </item>
</layer-list>
