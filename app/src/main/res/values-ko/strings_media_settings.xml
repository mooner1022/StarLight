    <string name="media_settings_other_users_status_title">듀얼 메신저 카카오톡</string>
    <string name="media_settings_other_users_status_desc">다른 사용자(듀얼 메신저)의 카카오톡 방으로 선택창 없이 보내려면 권한을 부여해야 해요:\nadb shell pm grant %1$s %2$s</string>
