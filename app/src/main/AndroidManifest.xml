<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">

    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <!-- Lets the AI agent's progress show as a Live Update on Android 16 QPR2 and later; granted at install. -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
    <queries>
        <package android:name="com.kakao.talk"/>
        <package android:name="dev.mooner.starlight"/>
    </queries>

    <application
        android:name=".core.GlobalApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:extractNativeLibs="false"
        android:fullBackupContent="@xml/backup_descriptor"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:requestLegacyExternalStorage="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.StarLight.NoActionBar"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".ui.splash.intro.IntroActivity"
            android:exported="false"/>
        <activity
            android:name=".ui.settings.solver.ProblemSolverActivity"
            android:exported="false"/>
        <activity
            android:name=".ui.scheme.SchemeHandlerActivity"
            android:exported="true">
            <intent-filter>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>

                <action android:name="android.intent.action.VIEW"/>

                <data
                    android:host="action"
                    android:scheme="starlight"/>
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.settings.notifications.NotificationRulesActivity"
            android:exported="false"/>
        <activity android:name=".ui.config.ConfigActivity"/>
        <activity android:name=".ui.settings.info.AppInfoActivity"/>
        <activity android:name=".ui.crash.FatalErrorActivity"/>
        <activity android:name=".ui.plugins.config.PluginConfigActivity"/>
        <activity android:name=".ui.plugins.store.PluginStoreActivity"/>
        <activity
            android:name=".ui.splash.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>

                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <activity android:name=".ui.projects.config.ProjectConfigActivity"/>
        <activity android:name=".ui.editor.DefaultEditorActivity"/>
        <activity android:name=".ui.debugroom.DebugRoomActivity"/>
        <activity
            android:name=".MainActivity"
            android:label="@string/app_name"/>

        <service
            android:name=".core.ForegroundTask"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the messenger auto-reply bot and its user scripts running"/>
        </service>
        <service
            android:name=".utils.NotificationEventService"
            android:exported="false"/>
        <service
            android:name=".listener.NotificationListener"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService"/>
            </intent-filter>
        </service>

        <receiver
            android:name=".listener.LocaleReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.LOCALE_CHANGED"/>
            </intent-filter>
        </receiver>

        <!-- AI agent -->
        <activity
            android:name=".ui.agent.AgentChatActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"/>
        <activity
            android:name=".ui.agent.AgentSettingsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"/>
        <activity
            android:name=".ui.agent.docs.AgentDocsActivity"
            android:exported="false"/>
        <activity
            android:name=".ui.agent.docs.AgentDocActivity"
            android:exported="false"/>
        <activity
            android:name=".ui.agent.AgentReturnActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>

                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>

                <data
                    android:host="agent"
                    android:scheme="starlight"/>
            </intent-filter>
        </activity>

        <service
            android:name=".agent.runtime.AgentService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:stopWithTask="false"/>
        <receiver
            android:name=".agent.runtime.AgentActionReceiver"
            android:exported="false"/>
        <!-- Scripts' scheduled tasks (Schedule): wakes the device for the next one. -->
        <receiver
            android:name=".script.schedule.ScheduleAlarms$Receiver"
            android:exported="false"/>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="dev.mooner.starlight.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"/>
        </provider>
    </application>

</manifest>